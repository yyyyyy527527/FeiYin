{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.KEEP_BACKGROUND_RUNNING" },
      { "name": "ohos.permission.DETECT_GESTURE" },
      { "name": "ohos.permission.MICROPHONE", "reason": "$string:perm_mic_reason", "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } }
    ],
    "metadata": [
      {
        "name": "ohos.net.http.NetworkSecurityConfig",
        "resource": "$profile:network_config"
      },
      {
        // 华为账号（Account Kit）登录必需。
        // 实测：即使 Client ID == APP ID，不配这条也会报 1001502009，所以必须显式声明。
        // 该值来自 AGC「项目设置 → 常规 → 应用」，对应的包名是 com.limerence.feiyin。
        "name": "client_id",
        "value": "6917620983568967225"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ],
        // 桌面长按图标快捷方式：随机播放 / 播放喜爱 / 每日推荐
        "metadata": [
          {
            "name": "ohos.ability.shortcuts",
            "resource": "$profile:shortcuts"
          }
        ],
        "backgroundModes": ["audioPlayback"]
      }
    ],
    "extensionAbilities": [
      {
        // 桌面播放卡片。之前只在 form_config.json 里写了卡片样式、
        // 这里却没注册扩展，桌面根本添加不了卡片——补上注册。
        "name": "MusicFormAbility",
        "srcEntry": "./ets/form/MusicFormAbility.ets",
        "description": "$string:form_desc",
        "type": "form",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ]
  }
}
